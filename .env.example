# 複製成 .env 後填入。.env 已在 .gitignore 裡，不會進版控。
# 填好之後跑 `python examples/00_check_setup.py` 確認環境就緒。

# ── 必要 ──────────────────────────────────────────────
# 到 https://ollama.com/settings/keys 建立
OLLAMA_API_KEY=

# ── 選用 ──────────────────────────────────────────────
# 預設 gpt-oss:120b（免費方案可用）。免費方案另有 gpt-oss:20b、gemma4:31b
OLLAMA_MODEL=gpt-oss:120b

# 第 7 節 Codebase Agent 要分析的專案根目錄
AGENT_ROOT=.

# 第 15 節 Langfuse 可觀測性。
# 雲端版到 https://cloud.langfuse.com 開專案取得；
# 沒有帳號也想驗證的話，跑 examples/tools/fake_langfuse_server.py，
# 然後把 LANGFUSE_HOST 設成 http://localhost:3999
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
